---
import Layout from './Layout.astro';

// Wraps a generated markdown document - currently just the protocol spec. The
// legal pages hand-write their own markup and keep their own styles; this is
// for pages whose body arrives as markdown from somewhere else, where the
// styling has to cover whatever the source happens to contain.
const { frontmatter } = Astro.props;
const { title, description, sourceRevision, sourceDate } = frontmatter;
---

<Layout title={title} description={description}>
  <main class="doc">
    <div class="container">
      <slot />

      {sourceRevision && (
        <p class="provenance">
          Generated from <code>PROTOCOL.md</code> at revision <code>{sourceRevision}</code>{
            sourceDate ? `, last changed ${sourceDate}` : ''
          }. The specification is the source of truth for every Rachel client;
          where it and a client disagree, the specification is what gets fixed.
        </p>
      )}

      <p class="back-link"><a href="/">&lsaquo; Back to Rachel</a></p>
    </div>
  </main>
</Layout>

<style>
  .doc {
    background: var(--felt-deep);
    padding: 4rem 0;
  }

  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Markdown arrives as bare tags, so everything is styled by element. */
  .doc :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.5rem);
    margin-bottom: 1.5rem;
    line-height: 1.15;
  }

  .doc :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: 3rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .doc :global(h3) {
    font-size: 1.1rem;
    margin: 2rem 0 0.75rem;
  }

  .doc :global(h4) {
    font-size: 1rem;
    margin: 1.5rem 0 0.5rem;
    color: var(--text-muted);
  }

  .doc :global(p),
  .doc :global(li) {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .doc :global(ul),
  .doc :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .doc :global(li) { margin-bottom: 0.4rem; }

  .doc :global(strong) { color: var(--text); }

  .doc :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875em;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.1em 0.4em;
    border-radius: 0.25rem;
    color: var(--text);
  }

  /* The spec is mostly byte tables and box-drawing diagrams, and they are the
     part a port author actually reads. They must not wrap, and they must not
     make the page scroll sideways - so each block scrolls in its own right. */
  .doc :global(pre) {
    background: rgba(0, 0, 0, 0.32);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .doc :global(pre code) {
    background: none;
    padding: 0;
    white-space: pre;
  }

  .doc :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
  }

  .doc :global(th),
  .doc :global(td) {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
  }

  .doc :global(th) { color: var(--text); }

  /* Tables of message types run wide on a phone. */
  .doc :global(.table-scroll) { overflow-x: auto; }

  .doc :global(hr) {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 2.5rem 0;
  }

  .doc :global(blockquote) {
    border-left: 3px solid rgba(255, 255, 255, 0.2);
    padding-left: 1rem;
    margin-bottom: 1rem;
  }

  .provenance,
  .back-link {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .back-link {
    margin-top: 1.5rem;
    padding-top: 0;
    border-top: none;
  }
</style>
