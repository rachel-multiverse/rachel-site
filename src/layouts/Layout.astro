---
import '../styles/tokens.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A tactical card game for iPhone, iPad and Apple silicon Mac" } = Astro.props;

// Absolute, because Open Graph consumers do not resolve relative URLs - a
// root-relative /images/og-card.png is fetched against their own host and
// quietly comes back 404, which is why a link can preview with a title and no
// picture. `site` is set in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/og-card.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link
      rel="preload"
      href="/fonts/playfair-display-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    {/* Without these a shared link is a bare URL: no title card, no picture,
        no description. For a site whose whole job before launch is to be
        passed around, that was the largest thing missing from it.

        og: is read by iMessage, Slack, Discord, WhatsApp, Mastodon, LinkedIn
        and Facebook; twitter: only adds the large-image card on X, which
        otherwise falls back to a small thumbnail. Both are cheap. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rachel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rachel — your next card night on iPhone, iPad and Apple silicon Mac" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f8f4e9" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <slot />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    background: var(--felt-deep);
    color: var(--text);
    line-height: 1.6;
  }

  body {
    min-height: 100vh;
  }

  a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a:hover {
    text-decoration: none;
  }
</style>

<style is:global>
  h1, h2, h3 { text-wrap: balance; }
  p { text-wrap: pretty; }
  :focus-visible { outline: 3px solid var(--pip-red); outline-offset: 5px; }
  .skip-link { position: absolute; top: -5rem; left: 1rem; z-index: 10; background: var(--card-stock); padding: .75rem 1rem; }
  .skip-link:focus { top: 1rem; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
</style>
