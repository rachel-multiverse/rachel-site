---
import AppStoreButton from './AppStoreButton.astro';
import PlayingCard from './PlayingCard.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="copy">
      <p class="eyebrow">A little friendly trouble.</p>
      <h1 id="hero-title">Your next<br /><em>card night.</em></h1>
      <p class="promise">Pull up a chair. Get rid of your cards.<br />Try to leave your friends holding the rest.</p>
      <p class="description">Rachel is a tactical card game with a mischievous streak. Play a quiet solo hand or invite your favourite rivals to the table.</p>
      <div class="actions"><AppStoreButton size="large" /><a class="text-link" href="#how-to-play">Meet the game <span aria-hidden="true">↓</span></a></div>
      <p class="meta">iPhone, iPad &amp; Apple silicon Mac<br />Buy once. No ads or in-app purchases.</p>
    </div>
    <figure class="stage">
      <div class="sun" aria-hidden="true"></div>
      <div class="tablet"><img src="/images/emissary-table.webp" alt="Rachel's bright Saturday table on iPad, with drawn cards and three character opponents" width="1400" height="973" fetchpriority="high" /></div>
      <div class="loose ace"><PlayingCard rank="A" suit="hearts" /></div>
      <div class="loose seven"><PlayingCard rank="7" suit="clubs" /></div>
      <figcaption>One card left. Trouble ahead.</figcaption>
    </figure>
  </div>
  <div class="table-note"><span aria-hidden="true">♣</span> Good company. Questionable manners. <span aria-hidden="true">♥</span></div>
</section>
<style>
  .hero { padding: 4.5rem 0 0; overflow: clip; }
  .container { max-width: 1200px; margin: auto; padding: 0 2rem; display: grid; grid-template-columns: 1fr 1.1fr; gap: 2rem; align-items: center; }
  .eyebrow { color: var(--green); font-weight: 650; margin-bottom: 1.1rem; }
  h1 { font-family: var(--font-display); font-size: clamp(3.4rem, 6.4vw, 6rem); line-height: 1.04; letter-spacing: -.055em; margin-bottom: 1.5rem; }
  h1 em { color: var(--pip-red); font-style: normal; }
  .promise { font-size: clamp(1.1rem, 1.7vw, 1.3rem); line-height: 1.6; margin-bottom: 1rem; }
  .description { max-width: 29rem; color: var(--text-muted); margin-bottom: 1.8rem; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; }
  .text-link { font-weight: 600; text-decoration: none; padding: .7rem 0; }
  .text-link span { margin-left: .35rem; }
  .meta { margin-top: 1.2rem; color: var(--text-muted); font-size: .85rem; line-height: 1.7; }
  .stage { position: relative; padding: 4rem 0 3rem; min-width: 0; }
  .sun { position: absolute; inset: 0 -5rem 0 1rem; background: var(--mint); border-radius: 48% 52% 44% 56% / 52% 45% 55% 48%; transform: rotate(-8deg); }
  .tablet { position: relative; border: 7px solid var(--ink); border-radius: 1.7rem; overflow: hidden; transform: rotate(-5deg); box-shadow: 9px 12px 0 #263f6024; background: var(--ink); }
  .tablet img { display: block; width: 100%; height: auto; }
  .loose { position: absolute; --card-w: 88px; }
  .ace { left: -1.5rem; bottom: 1.2rem; transform: rotate(-17deg); }
  .seven { right: -.5rem; top: .5rem; transform: rotate(16deg); }
  figcaption { position: relative; text-align: center; font-family: var(--font-display); font-size: 1.05rem; transform: rotate(-3deg); margin: 2rem 0 0 1.5rem; }
  .table-note { margin-top: 4.5rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.05rem 1.5rem; text-align: center; font-size: .85rem; font-weight: 600; letter-spacing: .025em; }
  .table-note span { margin: 0 1.1rem; color: var(--pip-red); }
  @media (max-width: 820px) {
    .hero { padding-top: 2.5rem; }
    .container { grid-template-columns: 1fr; max-width: 620px; gap: 2.5rem; padding: 0 1.5rem; }
    h1 { font-size: clamp(3.4rem, 12vw, 5rem); }
    .description { max-width: 34rem; }
    .stage { margin: 0 1rem; padding: 2rem 0; }
    .sun { inset: 0 -1.5rem; }
    .loose { --card-w: 62px; }
    .table-note { margin-top: 3rem; }
    .tablet { border-width: 5px; border-radius: 1.1rem; }
  }
</style>
