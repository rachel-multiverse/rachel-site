---
import Layout from '../layouts/Layout.astro';
import { RELEASE_1_2_AVAILABLE } from '../config';
import Saturday from '../components/Saturday.astro';
import Hero from '../components/Hero.astro';
import Emissaries from '../components/Emissaries.astro';
import Protocol from '../components/Protocol.astro';
import HowItWorks from '../components/HowItWorks.astro';
import LearnByPlaying from '../components/LearnByPlaying.astro';
import PlayYourWay from '../components/PlayYourWay.astro';
import BuiltToBePlayable from '../components/BuiltToBePlayable.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
---

<Layout
  title="Rachel: Tactical Card Game"
  description={RELEASE_1_2_AVAILABLE ? "Pull up a chair in Rachel for iPhone, iPad and Apple silicon Mac. Play solo offline, nearby or with Game Center friends." : "Pull up a chair in Rachel. Coming in 1.2: Saturday, Game Center invitations and Apple silicon Mac support. Play the current app on iPhone and iPad."}
>
  <main id="main-content">
    <Hero />
    <HowItWorks />
    <Saturday />
    <LearnByPlaying />
    <PlayYourWay />
    <Emissaries />
    <BuiltToBePlayable />
    <Protocol />
    <ClosingCTA />

    <footer>
      <div class="container">
        <nav>
          <a href="/protocol">Protocol</a>
          <a href="/ports">Ports</a>
          <a href="/press">Press</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/support">Support</a>
        </nav>
        <p class="copyright">&copy; 2026 Steve Hill</p>
      </div>
    </footer>
  </main>
</Layout>

<style>
  footer {
    padding: 3rem 0;
    background: var(--felt-deep);
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  nav {
    display: flex;
    justify-content: center;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .copyright {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
